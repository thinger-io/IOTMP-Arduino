{
    "name": "IOTMP-Arduino",
    "version": "1.0.0",
    "description": "Thinger.io IOTMP client library for Arduino platforms",
    "keywords": "iot, thinger, iotmp, esp32, esp8266, ethernet, gsm, cellular, tinygsm",
    "repository": {
        "type": "git",
        "url": "https://github.com/thinger-io/iotmp-arduino.git"
    },
    "authors": [
        {
            "name": "Alvaro Luis Bustamante",
            "email": "alvarolb@gmail.com"
        }
    ],
    "license": "MIT",
    "frameworks": "arduino",
    "platforms": ["espressif32", "espressif8266", "atmelavr", "atmelsam", "ststm32"],
    "dependencies": {
        "iotmp-embedded": {
            "owner": "thinger-io",
            "name": "IOTMP-Embedded",
            "version": "https://github.com/thinger-io/IOTMP-Embedded.git"
        }
    },
    "build": {
        "srcFilter": ["+<src/>"],
        "includeDir": "src"
    }
}
